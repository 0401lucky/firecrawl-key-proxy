# 构建产物
/bin/
/server
/server.exe

# 前端构建输出（由 npm run build 生成，仅保留占位文件供 go:embed 使用）
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep
!/internal/webui/dist/index.html

# 依赖
/web/node_modules/

# 运行时数据
*.db
*.db-shm
*.db-wal
/data/

# 环境配置（含 ADMIN_PASSWORD 等敏感项）
.env
.env.local

# 注册器本地数据：账号密码与 API Key 明文、代理列表，绝不入库
/registerer/accounts.csv
/registerer/proxies.txt
/registerer/*.log

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/
*.png
