# 复制为 .env 并按需修改：cp .env.example .env
# 注意：.env 含 ADMIN_PASSWORD 等敏感项，已被 .gitignore 忽略，不要提交进版本库。

# 对外可访问地址（含协议）。用于响应体 URL 重写与客户端 SDK 接入。
# 有域名 + TLS 网关时填 https://your-domain.com；
# 仅本机测试时填 http://127.0.0.1:8080。
PUBLIC_BASE_URL=http://127.0.0.1:8080

# 面板管理员密码（必填）。务必改成强密码，不要在多个环境复用。
ADMIN_PASSWORD=change-me

# ---- 以下均为可选，去掉注释即覆盖默认值 ----

# 上游 Firecrawl 地址
# UPSTREAM_BASE_URL=https://api.firecrawl.dev

# 日志级别：debug / info / warn / error
# LOG_LEVEL=info

# 代理路径前缀（逗号分隔）
# PROXY_PATH_PREFIXES=/v1/,/v2/

# 单请求故障转移的最大换 Key 次数
# MAX_FAILOVER_ATTEMPTS=3

# 429 且无 Retry-After 时的默认冷却秒数
# DEFAULT_COOLDOWN_SECONDS=60

# 请求体缓冲上限（字节），超过上限的请求单次转发不重试
# MAX_REQUEST_BUFFER_BYTES=8388608

# 异步任务(job)到上游 Key 的映射保留小时数
# JOB_ROUTE_TTL_HOURS=48

# 面板「刷新额度」调上游接口的最小间隔分钟数
# CREDIT_REFRESH_MINUTES=10

# 面板登录会话有效期（小时）
# SESSION_TTL_HOURS=168

# ---- 可选：MCP 端点（docker compose --profile mcp up -d）----
# 给只支持远程 MCP、无法自定义 Firecrawl 地址的客户端用。
# MCP 服务端不接受客户端自带的 key，只能烘在服务端，所以必须自己加一道
# token 校验，否则谁知道 URL 谁就能用光你的额度。

# 面板「API Key」页创建一个专供 MCP 用的 Key，填在这里
# MCP_PROXY_KEY=fcp_xxxxxxxx

# 客户端访问 MCP 端点必须携带的 token（请求头 X-MCP-Token）
# 用 openssl rand -hex 32 生成，不要用弱口令
# MCP_ACCESS_TOKEN=

# MCP 网关在宿主机的回环端口
# MCP_HOST_PORT=8082
