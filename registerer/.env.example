# ===== Temp Mail（自建 CF 临时邮箱）=====
# worker 地址，例如 https://mail.lucky0506.shop
TEMP_MAIL_API_URL=https://your-temp-mail-worker.example.com
# admin 密码（x-admin-auth 请求头，管理后台的 ADMIN_PASSWORDS）
TEMP_MAIL_ADMIN_PASSWORD=replace-with-admin-password
# 收件基础域名（fallback：默认自动从 /open_api/settings 拉取全部支持随机子域名的域名并轮询）
# 仅当自动拉取不可用/需固定子集时配置，多域名用逗号分隔
TEMP_MAIL_DOMAIN=lucky0506.shop
# TEMP_MAIL_DOMAINS=lucky0506.shop,second.com

# ===== 上传到 Go 代理 =====
# 代理面板地址（Go 侧 /api/register/keys）
REGISTER_API_URL=https://firecrawl.lucky0625.us.ci
# 服务器 .env 里的 REGISTER_TOKEN
REGISTER_API_TOKEN=replace-with-register-token

# ===== 代理池（静态列表文件）=====
# 每行一条：http://user:pass@host:port 或 socks5://host:port，# 开头为注释
PROXY_FILE=proxies.txt

# ===== 运行参数 =====
# 是否无头浏览器（调试风控时可设 false 观察页面）
HEADLESS=true
# 注册数量与并发
DEFAULT_COUNT=1
DEFAULT_CONCURRENCY=2
# 每轮注册间隔（秒）
DEFAULT_DELAY=10
# 等待验证邮件超时（秒）
EMAIL_CODE_TIMEOUT=90
# 轮询间隔（秒）
EMAIL_POLL_INTERVAL=3
# API Key 验证超时（秒）
API_KEY_TIMEOUT=20
