# 可选组件：firecrawl-mcp 的 HTTP 服务镜像。
#
# 为什么单独固化成镜像而不是每次 npx 拉取：npx 每次启动都要联网下载，
# 冷启动要几十秒，且上游发版会让行为悄悄变化。这里锁定版本。
FROM node:22-alpine
RUN npm install -g firecrawl-mcp@3.23.0
# HOST 必须显式设为 0.0.0.0：firecrawl-mcp 默认绑 localhost
# （只有 CLOUD_SERVICE=true 时才自动绑 0.0.0.0），否则同一 compose 网络里的
# 认证网关连不上，表现为 502 connection refused。
ENV HTTP_STREAMABLE_SERVER=true \
    HOST=0.0.0.0 \
    PORT=3000
EXPOSE 3000
CMD ["firecrawl-mcp"]
